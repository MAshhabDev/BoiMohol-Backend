model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  phone     String?   @unique
  role      Role      @default(CUSTOMER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  addresses Address[]
  orders    Order[]
  carts     Cart[]
  reviews   Review[]
  @@map("users")
}